{
  "expo": {
    "name": "Savora",
    "slug": "savora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#E1552B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shahjahaninnovative.savora"
    },
    "android": {
      "package": "com.shahjahaninnovative.savora",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Savora",
      "shortName": "Savora",
      "themeColor": "#FFFBF4",
      "backgroundColor": "#FFFBF4",
      "display": "standalone",
      "description": "Food and fitness diary that starts from your own home cuisine."
    }
  }
}
